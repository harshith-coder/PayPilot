# Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# PayPal sandbox (developer.paypal.com > Apps & Credentials > your sandbox app)
# Leave blank to run in MOCK mode (no real PayPal calls) for UI development.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Required for verified PayPal webhooks.
PAYPAL_WEBHOOK_ID=

DEFAULT_CURRENCY=USD
DB_PATH=paypilot.db
# Production PostgreSQL URL, for example from Supabase. Leave blank for SQLite.
DATABASE_URL=
MONGODB_URI=
MONGODB_DB=paypilot
AUTH_REQUIRED=false
